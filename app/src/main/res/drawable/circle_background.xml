<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/circle_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Fill color (white in this example) -->
    <solid android:color="@android:color/white" />

    <!-- Border around the circle -->
    <stroke
        android:width="2dp"
        android:color="@color/green" />

    <!-- Optional padding inside the circle -->
    <padding
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp" />
</shape>
