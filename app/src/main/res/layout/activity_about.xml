<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/kisan_logo1"
            android:scaleType="centerCrop"
            android:padding="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Farmer App"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1C1E"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Farming Powered by Artificial Intelligence"
            android:textSize="14sp"
            android:textColor="#74777F"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- Divider -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/tvTagline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"/>

        <!-- About Section Title -->
        <TextView
            android:id="@+id/tvAboutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About the App"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1C1E"
            app:layout_constraintTop_toBottomOf="@id/tvTagline"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="30dp"/>

        <!-- About Description -->
        <TextView
            android:id="@+id/tvAboutDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="AI Farmer App is a smart agriculture platform designed to empower farmers using Artificial Intelligence. The app provides crop guidance, disease detection support, worker community access, government scheme updates, and real-time agricultural insights. Our mission is to make farming more efficient, profitable, and technology-driven."
            android:textSize="14sp"
            android:textColor="#555555"
            android:lineSpacingExtra="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvAboutTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- Features Title -->
        <TextView
            android:id="@+id/tvFeaturesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Features"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1C1E"
            app:layout_constraintTop_toBottomOf="@id/tvAboutDesc"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <!-- Features List -->
        <TextView
            android:id="@+id/tvFeatures"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="• AI-based Crop Assistance\n• Smart Disease Identification\n• Worker Community Platform\n• Government Scheme Updates\n• Agricultural News and Announcements\n• Document Management Support"
            android:textSize="14sp"
            android:textColor="#555555"
            android:lineSpacingExtra="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvFeaturesTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

        <!-- Version Info -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0.0"
            android:textSize="13sp"
            android:textColor="#999999"
            app:layout_constraintTop_toBottomOf="@id/tvFeatures"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>